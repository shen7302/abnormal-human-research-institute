    loadHistory();
    int op;
    while (true) {
        cout << "\n===== 文本检索系统 =====\n"
             << "1.添加文档 2.文档列表 3.查看文档 4.删除文档\n"
             << "5.构建索引 6.精准搜索 7.前缀搜索 8.同义词搜索\n"
             << "9.布尔查询 10.搜索历史 11.链表演示 0.退出\n请选择：";
        if (!(cin >> op)) { cin.clear(); cin.ignore(10000,'\n'); continue; }
        if (op == 0) { saveHistory(); break; }
        
        string kw;
        switch (op) {
            case 1: addDoc(); break;
            case 2: listDocs(); break;
            case 3: viewDoc(); break;
            case 4: deleteDoc(); break;
            case 5: buildIndex(); break;
            case 6: 
                cout << "关键词："; cin.ignore(); getline(cin, kw);
                printSearchResults(exactSearch(kw), kw);
                searchHistory.push_back("精准:" + kw);
                break;
            case 7:
                cout << "前缀："; cin.ignore(); getline(cin, kw);
                printSearchResults(triePrefixSearch(kw));
                searchHistory.push_back("前缀:" + kw);
                break;
            case 8:
                cout << "关键词："; cin.ignore(); getline(cin, kw);
                printSearchResults(synonymSearch(kw));
                searchHistory.push_back("同义:" + kw);
                break;
            case 9:
                cout << "布尔表达式："; cin.ignore(); getline(cin, kw);
                printSearchResults(boolSearch(kw));
                searchHistory.push_back("布尔:" + kw);
                break;
            case 10:
                cout << "=== 搜索历史 ===\n";
                for (const auto& h : searchHistory) cout << h << "\n";
                break;
            case 11: {
                vector<string> demo = {"apple","banana","cherry"};
                LinkNode* head = createList(demo);
                cout << "链表演示："; printList(head); freeList(head);
                break;
            }
            default: cout << "无效选项。\n";
        }
    }
    return 0;
}
