using namespace std;

// 文档结构体
struct Doc {
    int id;
    string content;
};

// 全局核心数据
vector<Doc> docs;
unordered_map<string, vector<int>> invertIndex;
// 同义词/别名库（表格要求功能）
unordered_map<string, vector<string>> synonymDict;

// ===================== 1. 文本预处理（表格指定要求） =====================
// 把原始文档清洗、拆分、转为可建立索引的标准词项
vector<string> preprocessText(string rawStr) {
    vector<string> words;
    string tempWord;

    for (char c : rawStr) {
        // 字母统一转小写，过滤标点空格
        if (isalpha(c)) {
            tempWord += tolower(c);
        } else {
            if (!tempWord.empty()) {
                words.push_back(tempWord);
                tempWord.clear();
            }
        }
    }
    if (!tempWord.empty()) words.push_back(tempWord);

    // 单文档内词项去重，优化索引
    sort(words.begin(), words.end());
    auto last = unique(words.begin(), words.end());
    words.erase(last, words.end());

    return words;
}

// ===================== 2. 构建倒排索引 =====================
void buildIndex() {
    invertIndex.clear();
    for (const Doc& d : docs) {
        vector<string> terms = preprocessText(d.content);
        for (string& term : terms) {
            invertIndex[term].push_back(d.id);
        }
    }
    cout << "✅ 全文索引构建完成\n" << endl;
}

// ===================== 3. 基础精准查询 =====================
vector<Doc> exactSearch(string keyword) {
    vector<Doc> res;
    transform(keyword.begin(), keyword.end(), keyword.begin(), ::tolower);

    if (!invertIndex.count(keyword)) return res;

    for (int docId : invertIndex[keyword]) {
        res.push_back(docs[docId]);
    }
    return res;
}

// ===================== 4. 模糊/前缀匹配（表格指定核心功能） =====================
// 例子：输入"食"，匹配"食堂、食物、食堂楼"等
vector<Doc> prefixFuzzySearch(string prefix) {
    vector<Doc> res;
    transform(prefix.begin(), prefix.end(), prefix.begin(), ::tolower);

    for (auto& item : invertIndex) {
        string word = item.first;
        // 前缀匹配判定
        if (word.size() >= prefix.size() 
            && word.substr(0, prefix.size()) == prefix) {
            // 去重加入结果
            for (int id : item.second) {
                bool exist = false;
                for (auto& r : res) {
                    if (r.id == id) { exist = true; break; }
                }
                if (!exist) res.push_back(docs[id]);
            }
        }
    }
    return res;
}

// ===================== 5. 同义词/别名管理（表格指定功能） =====================
vector<Doc> synonymSearch(string word) {
    vector<Doc> totalRes;
    vector<string> searchList;
    searchList.push_back(word);

    // 追加所有同义词、别名一起检索
    if (synonymDict.find(word) != synonymDict.end()) {
        for (auto& s : synonymDict[word]) {
            searchList.push_back(s);
        }
    }

    // 合并所有查询结果
    for (auto& w : searchList) {
        auto tmp = exactSearch(w);
        totalRes.insert(totalRes.end(), tmp.begin(), tmp.end());
    }

    // 结果文档去重
    sort(totalRes.begin(), totalRes.end(), [](const Doc& a, const Doc& b){
        return a.id < b.id;
    });
    auto uniqueEnd = unique(totalRes.begin(), totalRes.end(), [](const Doc& a, const Doc& b){
        return a.id == b.id;
    });
    totalRes.erase(uniqueEnd, totalRes.end());

    return totalRes;
}

// ===================== 6. 结果高亮定位（表格指定） =====================
string highlightKeyword(string text, string key) {
    size_t pos = 0;
    string lowText = text;
    transform(lowText.begin(), lowText.end(), lowText.begin(), ::tolower);
    transform(key.begin(), key.end(), key.begin(), ::tolower);

    // 给所有命中关键词加红色高亮
    while ((pos = lowText.find(key, pos)) != string::npos) {
        text.insert(pos, "\033[31m");
        text.insert(pos + key.size(), "\033[0m");
        pos += key.size() + 9;
    }
    return text;
}

// ===================== 7. 摘要生成（表格指定） =====================
string generateAbstract(string fullText, string key) {
    // 定位关键词位置，截取前后上下文生成精简摘要
    size_t pos = fullText.find(key);
    if (pos == string::npos) pos = 0;
    int start = max(0, (int)pos - 15);
    return "..." + fullText.substr(start, 70) + "...";
}

