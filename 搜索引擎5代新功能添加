from collections import defaultdict

# ====================== 1. 网页链接图 + 简易PageRank ======================
def calc_pagerank(web_graph, damping=0.85, iterations=20):
    nodes = list(web_graph.keys())
    node_num = len(nodes)
    if node_num == 0:
        return {}
    rank = {n: 1.0 / node_num for n in nodes}

    for _ in range(iterations):
        new_rank = {}
        for target in nodes:
            incoming_sum = 0.0
            for src, out_links in web_graph.items():
                if target in out_links and len(out_links) > 0:
                    incoming_sum += rank[src] / len(out_links)
            # PageRank公式
            new_rank[target] = (1 - damping) / node_num + damping * incoming_sum
        rank = new_rank
    # 按权重降序排序
    return dict(sorted(rank.items(), key=lambda x: x[1], reverse=True))

# ====================== 2. 搜索词共现图（查询联想扩展） ======================
class WordCoGraph:
    def __init__(self):
        self.graph = defaultdict(lambda: defaultdict(int))

    def add_cooccur_pair(self, w1, w2):
        self.graph[w1][w2] += 1
        self.graph[w2][w1] += 1

    def get_recommend_words(self, keyword, top_k=3):
        if keyword not in self.graph:
            return []
        items = sorted(self.graph[keyword].items(), key=lambda x: x[1], reverse=True)
        return [word for word, cnt in items[:top_k]]

# ====================== 3. 点击流行为图谱（排序调优提权） ======================
class ClickFlowGraph:
    def __init__(self):
        self.trans_count = defaultdict(int)
        self.page_boost = defaultdict(float)

    def add_click_path(self, path_list):
        for i in range(len(path_list)-1):
            u = path_list[i]
            v = path_list[i+1]
            self.trans_count[(u, v)] += 1

    def compute_boost_score(self, weight_coeff=0.1):
        self.page_boost.clear()
        for (u, v), cnt in self.trans_count.items():
            self.page_boost[v] += cnt * weight_coeff

    def get_boost_score(self, page):
        return self.page_boost.get(page, 0.0)

# ====================== 4. Trie字典树（有限状态自动机/前缀索引） ======================
class TrieNode:
    __slots__ = ("children", "is_end")
    def __init__(self):
        self.children = dict()
        self.is_end = False

class TrieIndex:
    def __init__(self):
        self.root = TrieNode()

    def insert_word(self, word):
        node = self.root
        for ch in word:
            if ch not in node.children:
                node.children[ch] = TrieNode()
            node = node.children[ch]
        node.is_end = True

    def _dfs_collect(self, node, prefix, result):
        if node.is_end:
            result.append(prefix)
        for char, child_node in node.children.items():
            self._dfs_collect(child_node, prefix + char, result)

    def prefix_match(self, prefix):
        node = self.root
        for ch in prefix:
            if ch not in node.children:
                return []
            node = node.children[ch]
        res = []
        self._dfs_collect(node, prefix, res)
        return res

