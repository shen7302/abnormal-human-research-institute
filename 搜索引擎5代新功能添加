#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_NODE 64
#define MAX_STR_LEN 32
#define MAX_WORD_NUM 64

// ====================== 1. PageRank 网页链接图 ======================
typedef struct {
    char name[MAX_STR_LEN];
    char outLinks[MAX_NODE][MAX_STR_LEN];
    int outCnt;
} WebNode;

WebNode webGraph[MAX_NODE];
int webNodeCnt = 0;
double pageRank[MAX_NODE];

int findWebNode(const char *name) {
    for (int i = 0; i < webNodeCnt; i++) {
        if (strcmp(webGraph[i].name, name) == 0)
            return i;
    }
    return -1;
}

void addWebEdge(const char *from, const char *to) {
    int u = findWebNode(from);
    if (u == -1) {
        strcpy(webGraph[webNodeCnt].name, from);
        webGraph[webNodeCnt].outCnt = 0;
        u = webNodeCnt++;
    }
    strcpy(webGraph[u].outLinks[webGraph[u].outCnt++], to);

    int v = findWebNode(to);
    if (v == -1) {
        strcpy(webGraph[webNodeCnt].name, to);
        webGraph[webNodeCnt].outCnt = 0;
        webNodeCnt++;
    }
}

void calcPageRank(double damping, int iter) {
    double tmpRank[MAX_NODE];
    int n = webNodeCnt;
    for (int i = 0; i < n; i++) pageRank[i] = 1.0 / n;

    for (int step = 0; step < iter; step++) {
        for (int j = 0; j < n; j++) tmpRank[j] = 0.0;
        for (int target = 0; target < n; target++) {
            double sum = 0.0;
            for (int src = 0; src < n; src++) {
                for (int e = 0; e < webGraph[src].outCnt; e++) {
                    if (strcmp(webGraph[src].outLinks[e], webGraph[target].name) == 0) {
                        sum += pageRank[src] / webGraph[src].outCnt;
                        break;
                    }
                }
            }
            tmpRank[target] = (1 - damping) / n + damping * sum;
        }
        memcpy(pageRank, tmpRank, sizeof(pageRank));
    }
}

// ====================== 2. 词共现图（搜索联想） ======================
typedef struct {
    char w1[MAX_STR_LEN], w2[MAX_STR_LEN];
    int cnt;
} WordEdge;
WordEdge wordEdges[MAX_WORD_NUM];
int wordEdgeCnt = 0;

void addWordCooccur(const char *a, const char *b) {
    for (int i = 0; i < wordEdgeCnt; i++) {
        if ((strcmp(wordEdges[i].w1, a)==0 && strcmp(wordEdges[i].w2,b)==0) ||
            (strcmp(wordEdges[i].w1, b)==0 && strcmp(wordEdges[i].w2,a)==0)) {
            wordEdges[i].cnt++;
            return;
        }
    }
    strcpy(wordEdges[wordEdgeCnt].w1, a);
    strcpy(wordEdges[wordEdgeCnt].w2, b);
    wordEdges[wordEdgeCnt++].cnt = 1;
}

void getRecommend(const char *key, char res[][MAX_STR_LEN], int topK, int *retCnt) {
    int idx[MAX_WORD_NUM], val[MAX_WORD_NUM], total=0;
    *retCnt = 0;
    for (int i = 0; i < wordEdgeCnt; i++) {
        if (strcmp(wordEdges[i].w1, key)==0) {
            idx[total] = i; val[total++] = wordEdges[i].cnt;
        } else if (strcmp(wordEdges[i].w2, key)==0) {
            idx[total] = i; val[total++] = wordEdges[i].cnt;
        }
    }
    // 冒泡降序
    for (int i=0; i<total; i++){
        for(int j=i+1;j<total;j++){
            if(val[j]>val[i]){
                int t=val[i]; val[i]=val[j]; val[j]=t;
                t=idx[i]; idx[i]=idx[j]; idx[j]=t;
            }
        }
    }
    int limit = total < topK ? total : topK;
    for(int i=0;i<limit;i++){
        WordEdge e = wordEdges[idx[i]];
        if(strcmp(e.w1, key)==0) strcpy(res[(*retCnt)++], e.w2);
        else strcpy(res[(*retCnt)++], e.w1);
    }
}

// ====================== 3. 点击流行为图谱 ======================
typedef struct {
    char u[MAX_STR_LEN], v[MAX_STR_LEN];
    int count;
} ClickEdge;
ClickEdge clickEdges[MAX_NODE];
int clickEdgeCnt = 0;
double clickBoost[MAX_NODE];

int findClickEdge(const char *a, const char *b) {
    for(int i=0;i<clickEdgeCnt;i++){
        if(strcmp(clickEdges[i].u,a)==0 && strcmp(clickEdges[i].v,b)==0)
            return i;
    }
    return -1;
}

void addClickPath(char path[][MAX_STR_LEN], int len) {
    for(int i=0;i<len-1;i++){
        char *u = path[i], *v = path[i+1];
        int pos = findClickEdge(u, v);
        if(pos != -1){
            clickEdges[pos].count++;
        }else{
            strcpy(clickEdges[clickEdgeCnt].u, u);
            strcpy(clickEdges[clickEdgeCnt].v, v);
            clickEdges[clickEdgeCnt++].count = 1;
        }
    }
}

void calcClickBoost(double coeff) {
    memset(clickBoost, 0, sizeof(clickBoost));
    for(int e=0;e<clickEdgeCnt;e++){
        int vid = findWebNode(clickEdges[e].v);
        if(vid != -1){
            clickBoost[vid] += clickEdges[e].count * coeff;
        }
    }
}

// ====================== 4. Trie字典树（有向图，前缀索引） ======================
typedef struct TrieNode {
    struct TrieNode *next[26];
    int isEnd;
} TrieNode;

TrieNode* trieCreate() {
    TrieNode *p = (TrieNode*)malloc(sizeof(TrieNode));
    memset(p->next, 0, sizeof(p->next));
    p->isEnd = 0;
    return p;
}

void trieInsert(TrieNode *root, const char *s) {
    TrieNode *p = root;
    while(*s){
        int c = *s - 'a';
        if(!p->next[c]) p->next[c] = trieCreate();
        p = p->next[c];
        s++;
    }
    p->isEnd = 1;
}

void trieDfs(TrieNode *p, char buf[], int pos, char res[][MAX_STR_LEN], int *rcnt) {
    if(p->isEnd){
        buf[pos] = '\0';
        strcpy(res[(*rcnt)++], buf);
    }
    for(int i=0;i<26;i++){
        if(p->next[i]){
            buf[pos] = 'a'+i;
            trieDfs(p->next[i], buf, pos+1, res, rcnt);
        }
    }
}

int triePrefixSearch(TrieNode *root, const char *pre, char res[][MAX_STR_LEN]) {
    TrieNode *p = root;
    char buf[MAX_STR_LEN];
    int rcnt = 0;
    int len = strlen(pre);
    strcpy(buf, pre);
    for(int i=0;i<len;i++){
        int c = pre[i]-'a';
        if(!p->next[c]) return 0;
        p = p->next[c];
    }
    trieDfs(p, buf, len, res, &rcnt);
    return rcnt;
}

void trieFree(TrieNode *root) {
    if(!root) return;
    for(int i=0;i<26;i++) trieFree(root->next[i]);
    free(root);
}

// ====================== 主函数演示入口 ======================
int main() {
    printf("========== C语言简易搜索引擎（四类图结构实现）==========\n\n");

    // 1. PageRank 网页链接图
    addWebEdge("pageA", "pageB");
    addWebEdge("pageA", "pageC");
    addWebEdge("pageB", "pageC");
    addWebEdge("pageC", "pageA");
    addWebEdge("pageD", "pageA");
    addWebEdge("pageD", "pageB");
    calcPageRank(0.85, 20);
    printf("【1.PageRank 网页权重】\n");
    for(int i=0;i<webNodeCnt;i++){
        printf("%s : %.4f\n", webGraph[i].name, pageRank[i]);
    }
    puts("--------------------------------------------------------");

    // 2. 搜索词共现联想
    addWordCooccur("python", "编程");
    addWordCooccur("python", "数据分析");
    addWordCooccur("python", "爬虫");
    addWordCooccur("编程", "java");
    addWordCooccur("编程", "python");
    char recWords[8][MAX_STR_LEN];
    int recNum;
    getRecommend("python", recWords, 3, &recNum);
    printf("【2.搜索词联想（python）】\n推荐：");
    for(int i=0;i<recNum;i++) printf("%s ", recWords[i]);
    puts("\n--------------------------------------------------------");

    // 3. 点击流行为提权
    char path1[][MAX_STR_LEN] = {"pageA","pageC","pageD"};
    char path2[][MAX_STR_LEN] = {"pageA","pageC","pageB"};
    char path3[][MAX_STR_LEN] = {"pageB","pageC","pageD"};
    addClickPath(path1,3);
    addClickPath(path2,3);
    addClickPath(path3,3);
    calcClickBoost(0.1);
    printf("【3.点击流页面加分】\n");
    for(int i=0;i<webNodeCnt;i++){
        printf("%s 加分: %.2f\n", webGraph[i].name, clickBoost[i]);
    }
    puts("--------------------------------------------------------");

    // 4. Trie前缀索引检索
    TrieNode *trie = trieCreate();
    trieInsert(trie, "python");
    trieInsert(trie, "pycharm");
    trieInsert(trie, "pandas");
    trieInsert(trie, "pygame");
    trieInsert(trie, "java");
    trieInsert(trie, "javascript");
    char trieRes[16][MAX_STR_LEN];
    int matchCnt = triePrefixSearch(trie, "py", trieRes);
    printf("【4.Trie前缀匹配 py】\n结果：");
    for(int i=0;i<matchCnt;i++) printf("%s ", trieRes[i]);
    puts("\n\n================运行完成================");

    trieFree(trie);
    return 0;
}
